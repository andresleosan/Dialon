{
  "name": "dialon",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "scripts": {
    "typecheck": "node scripts/api-tool.mjs types && tsc -p packages/contracts && tsc -p packages/core && tsc -p packages/api-client && tsc -p apps/api && tsc -p apps/mobile",
    "lint": "eslint .",
    "test": "vitest run && apps/mobile/node_modules/.bin/jest --config apps/mobile/package.json",
    "test:api:integration": "node scripts/api-tool.mjs integration",
    "build:web": "node scripts/build-web.mjs",
    "build:api": "node scripts/api-tool.mjs build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=24"
  }
}
